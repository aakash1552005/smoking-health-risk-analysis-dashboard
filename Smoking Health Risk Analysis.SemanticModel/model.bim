            "name": "Alcohol_Consumption",
            "dataType": "string",
            "lineageTag": "f3143c95-426f-4187-9bd7-b86cf6769191",
            "sourceColumn": "Alcohol_Consumption"
          },
          {
            "name": "Age Group",
            "dataType": "string",
            "expression": "SWITCH(TRUE(), health_dataset[Age] <= 28, \"18–28\", health_dataset[Age] <= 38, \"29–38\", health_dataset[Age] <= 48, \"39–48\", health_dataset[Age] <= 58, \"49–58\", health_dataset[Age] <= 68, \"59–68\", \"69+\")",
            "isDataTypeInferred": true,
            "lineageTag": "f89d3fff-4ed6-47bd-bbea-9e94f5d3365b",
            "type": "calculated"
          }
        ],
        "lineageTag": "4158e020-c607-4e42-848c-641c489d907c",
        "measures": [
          {
            "name": "vs Avg Age",
            "expression": [
              "VAR _CurrentAge = AVERAGE(health_dataset[Age])",
              "VAR _OverallAge = CALCULATE(AVERAGE(health_dataset[Age]), ALL(health_dataset))",
              "VAR _Diff = _CurrentAge - _OverallAge",
              "RETURN",
              "SWITCH(",
              "    TRUE(),",
              "    _Diff > 0, UNICHAR(9650) & \" \" & FORMAT(_CurrentAge, \"0.0\"),",
              "    _Diff < 0, UNICHAR(9660) & \" \" & FORMAT(_CurrentAge, \"0.0\"),",
              "    FORMAT(_CurrentAge, \"0.0\")",
              ")"
            ],
            "lineageTag": "0417809b-7251-4684-9477-f9f8477b00d7"
          },
          {
            "name": "vs Avg BMI",
            "expression": [
              "VAR _CurrentBMI = AVERAGE(health_dataset[BMI])",
              "VAR _OverallBMI = CALCULATE(AVERAGE(health_dataset[BMI]), ALL(health_dataset))",
              "VAR _Diff = _CurrentBMI - _OverallBMI",
              "RETURN",
              "SWITCH(",
              "    TRUE(),",
              "    _Diff > 0, UNICHAR(9650) & \" \" & FORMAT(_CurrentBMI, \"0.0\"),",
              "    _Diff < 0, UNICHAR(9660) & \" \" & FORMAT(_CurrentBMI, \"0.0\"),",
              "    FORMAT(_CurrentBMI, \"0.0\")",
              ")"
            ],
            "lineageTag": "42652eee-bf6f-4d15-aa5c-f2f2ef735111"
          },
          {
            "name": "Total Patients",
            "expression": "COUNTROWS(health_dataset)",
            "lineageTag": "ede70e9b-7192-427a-863e-ca152b4e8861"
          },
          {
            "name": "YOS",
            "expression": "AVERAGE(health_dataset[Years_of_Smoking])",
            "lineageTag": "a958738b-68ec-44c1-a195-7161a368c875"
          },
          {
            "name": "CPD",
            "expression": "AVERAGE(health_dataset[Cigarettes_Per_Day])",
            "lineageTag": "3ab89887-6008-4ee0-8bb6-792d299ca532"
          }
        ],
