            "sourceColumn": "Cholesterol_Level",
            "summarizeBy": "average"
          },
          {
            "name": "Family_History_Risk",
            "dataType": "string",
            "lineageTag": "775c95c7-5d1d-459b-a374-bf4c74658488",
            "sourceColumn": "Family_History_Risk"
